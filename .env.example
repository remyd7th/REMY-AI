# Copy to .env (never commit .env)
DATABASE_URL=postgresql://remy:remy@localhost:5432/remy
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=change-me-generate-32-chars
# Public URLs: localhost for dev, your VPS domain in production
BETTER_AUTH_URL=http://localhost:4000
WEB_URL=http://localhost:3000
API_PORT=4000
# Comma-separated email addresses allowed to access the Super Admin portal
SUPER_ADMIN_EMAILS=
# OAuth (fill when ready)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Transactional email for verification + password-reset (wired via Resend).
# Minimum to enable (pick ONE option, free tiers available):
#   Option A — Resend (free tier: 100 emails/day, no credit card) — CURRENT:
#     RESEND_API_KEY=
#   Option B — any SMTP (Gmail App Password, Mailgun, SendGrid, Postmark...):
#     SMTP_HOST=
#     SMTP_PORT=587
#     SMTP_USER=
#     SMTP_PASS=
#   Either way also set:
#     EMAIL_FROM=Remy AI <onboarding@resend.dev>
# NOTE: Resend's free tier without a verified domain only delivers to the
# Resend account owner's own address (onboarding@resend.dev sender).
# Verify a domain in Resend to email any user.
# Cloudflare R2 (S3-compatible)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=remy-docs
# Groq (hosted LLM, OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
